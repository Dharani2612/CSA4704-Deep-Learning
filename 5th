
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline
from sklearn.metrics import mean_squared_error

np.random.seed(42)

# Generate nonlinear data
X = np.linspace(0, 10, 150).reshape(-1, 1)
y = np.sin(X[:, 0]) + 0.1*X[:, 0]**2
y += np.random.normal(0, 0.5, 150)

# Train-test split
indices = np.random.permutation(150)
train = indices[:100]
test = indices[100:]

degrees = [1, 3, 9, 15]
train_errors = []
test_errors = []

plt.figure(figsize=(12, 7))
plt.scatter(X, y, color="black", label="Data")

for d in degrees:
    model = make_pipeline(
        PolynomialFeatures(d),
        LinearRegression()
    )

    model.fit(X[train], y[train])

    pred_train = model.predict(X[train])
    pred_test = model.predict(X[test])

    train_errors.append(
        mean_squared_error(y[train], pred_train)
    )
    test_errors.append(
        mean_squared_error(y[test], pred_test)
    )

    plt.plot(X, model.predict(X), label=f"Degree {d}")

plt.legend()
plt.title("Polynomial Regression")
plt.show()

# Error comparison
plt.plot(degrees, train_errors, "o-", label="Training")
plt.plot(degrees, test_errors, "s-", label="Validation")
plt.xlabel("Polynomial Degree")
plt.ylabel("Mean Squared Error")
plt.legend()
plt.grid()
plt.show()

# Bias-variance estimation by repeated resampling
predictions = []

for seed in range(30):
    rng = np.random.default_rng(seed)
    sample = rng.choice(train, size=len(train), replace=True)

    model = make_pipeline(
        PolynomialFeatures(3),
        LinearRegression()
    )
    model.fit(X[sample], y[sample])
    predictions.append(model.predict(X[test]))

predictions = np.array(predictions)

mean_prediction = predictions.mean(axis=0)
bias2 = np.mean((mean_prediction - y[test])**2)
variance = np.mean(np.var(predictions, axis=0))

print("Estimated Bias Squared:", bias2)
print("Estimated Variance:", variance)

print("Training Errors:", train_errors)
print("Validation Errors:", test_errors)
