
import numpy as np
import matplotlib.pyplot as plt

# Task 1: Create customer-genre and genre-book matrices
C = np.array([
    [5, 3, 0, 1, 2],
    [4, 0, 0, 1, 3],
    [1, 1, 5, 0, 0],
    [0, 2, 4, 5, 1],
    [3, 3, 1, 0, 2],
    [5, 2, 0, 1, 1]
], dtype=float)

B = np.array([
    [1, 0, 2, 1],
    [0, 1, 1, 2],
    [2, 1, 0, 0],
    [1, 2, 1, 0],
    [0, 1, 2, 1]
], dtype=float)

print("Customer-Genre Matrix (6x5):\n", C)
print("\nGenre-Book Matrix (5x4):\n", B)

# Task 2: Vector and matrix operations
v1 = C[0]
v2 = C[5]

print("\nDot Product of Customer 1 and Customer 6:",
      np.dot(v1, v2))

scores = np.dot(C, B)
print("\nCustomer-Book Score Matrix:\n", scores)

print("\nTranspose of Customer Matrix:\n", C.T)

# Inverse of a square, invertible matrix
A = np.array([[2, 1], [5, 3]], dtype=float)
print("\nInverse of Matrix A:\n", np.linalg.inv(A))

print("\nElement-wise Multiplication (C * 2):\n", C * 2)
print("\nElement-wise Addition (C + 1):\n", C + 1)

# Task 3: Cosine similarity between customers
norms = np.linalg.norm(C, axis=1, keepdims=True)
normalized_C = C / norms
similarity = normalized_C @ normalized_C.T

print("\nCosine Similarity Matrix:\n",
      np.round(similarity, 3))

# Find the two most similar distinct customers
pairs = [
    (i, j, similarity[i, j])
    for i in range(6)
    for j in range(i + 1, 6)
]
best = max(pairs, key=lambda p: p[2])

print("\nMost Similar Customers: Customer",
      best[0] + 1, "and Customer", best[1] + 1)
print("Cosine Similarity:", round(best[2], 4))

# Task 4: Dense layer y = Wx + b
x = C[0]
W = B.T
b = np.array([1, 0.5, -1, 2])

manual_result = W @ x
y = manual_result + b

print("\nDense Layer for Customer 1")
print("Wx =", manual_result)
print("Bias b =", b)
print("y = Wx + b =", y)

# Task 5: Visualize customer-book scores
plt.figure(figsize=(8, 5))
plt.imshow(scores, cmap="YlGnBu", aspect="auto")
plt.colorbar(label="Recommendation Score")
plt.xticks(range(4), ["Book 1", "Book 2", "Book 3", "Book 4"])
plt.yticks(range(6), ["Customer 1", "Customer 2",
                      "Customer 3", "Customer 4",
                      "Customer 5", "Customer 6"])
plt.title("Customer-Book Recommendation Score Heatmap")
plt.xlabel("Books")
plt.ylabel("Customers")

for i in range(scores.shape[0]):
    for j in range(scores.shape[1]):
        plt.text(j, i, int(scores[i, j]),
                 ha="center", va="center", color="black")

plt.tight_layout()
plt.show()
