
import numpy as np
import matplotlib.pyplot as plt

np.random.seed(42)

X = np.array([[0,0],[0,1],[1,0],[1,1]])
Y = np.array([[0],[1],[1],[0]])

def sigmoid(x):
    return 1/(1+np.exp(-x))

W1 = np.random.randn(2, 4)
b1 = np.zeros((1, 4))
W2 = np.random.randn(4, 1)
b2 = np.zeros((1, 1))

lr = 1.0
losses = []

for epoch in range(10000):

    # Forward
    Z1 = X @ W1 + b1
    A1 = sigmoid(Z1)

    Z2 = A1 @ W2 + b2
    A2 = sigmoid(Z2)

    loss = np.mean((A2-Y)**2)
    losses.append(loss)

    # Backward
    dZ2 = 2*(A2-Y)/len(X)
    dW2 = A1.T @ dZ2
    db2 = np.sum(dZ2, axis=0, keepdims=True)

    dA1 = dZ2 @ W2.T
    dZ1 = dA1*A1*(1-A1)

    dW1 = X.T @ dZ1
    db1 = np.sum(dZ1, axis=0, keepdims=True)

    # Update
    W1 -= lr*dW1
    b1 -= lr*db1
    W2 -= lr*dW2
    b2 -= lr*db2

print("Predictions:")
print(np.round(A2))

plt.plot(losses)
plt.xlabel("Epochs")
plt.ylabel("Loss")
plt.title("Backpropagation Training")
plt.show()

# Decision boundary
xx, yy = np.meshgrid(
    np.linspace(-0.5, 1.5, 100),
    np.linspace(-0.5, 1.5, 100)
)

grid = np.c_[xx.ravel(), yy.ravel()]

hidden = sigmoid(grid @ W1+b1)
pred = sigmoid(hidden @ W2+b2)

plt.contourf(
    xx, yy, pred.reshape(xx.shape),
    levels=20, cmap="coolwarm"
)
plt.scatter(X[:,0], X[:,1], c=Y.ravel(),
            edgecolors="black")
plt.title("XOR Decision Boundary")
plt.show()

# Numerical gradient verification for W1[0,0]
eps = 1e-5

def compute_loss():
    a1 = sigmoid(X @ W1+b1)
    a2 = sigmoid(a1 @ W2+b2)
    return np.mean((a2-Y)**2)

original = W1[0,0]

W1[0,0] = original+eps
plus = compute_loss()

W1[0,0] = original-eps
minus = compute_loss()

W1[0,0] = original

numerical = (plus-minus)/(2*eps)
print("Numerical Gradient:", numerical)
